{
  "permissions": {
    "allow": [
      "Bash(*)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(rm -f)",
      "Bash(rm -rf)",
      "Bash(> /)",
      "Bash(dd if=/dev/zero)",
      "Bash(dd if=/dev/null)",
      "Bash(mkfs)",
      "Bash(fdisk)",
      "Bash(kill -9 1)",
      "Bash(chmod -R 777 /)",
      "Bash(chown -R)",
      "Bash(git reset --hard)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git clean -fd)",
      "Bash(git clean -fdx)",
      "Bash(git clean -fx)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git branch -D)",
      "Bash(git push origin --delete)",
      "Bash(git stash clear)",
      "Bash(git reflog expire)",
      "Bash(git gc --prune=now)"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:omarchy",
  "model": "sonnet",
  "editorMode": "vim",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }
}
